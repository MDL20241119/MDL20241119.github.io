              },
              "synthetic": {
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "operation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,100}$"
                  },
                  "replayed": {
                    "type": "boolean"
                  },
                  "current": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "service_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "origin_stop_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "destination_stop_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "origin_name": {
                        "type": "string"
                      },
                      "destination_name": {
                        "type": "string"
                      },
