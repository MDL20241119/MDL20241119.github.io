{
  "name": "e-Palette ONE",
  "description": "合成データで乗車予約案・車両状況・充電計画を扱う検証用エージェント。変更には本人確認が必要。",
  "version": "1.1.0",
  "supportedInterfaces": [
    {
      "url": "https://epalette-one.delpiero.chatgpt.site/a2a",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "documentationUrl": "https://epalette-one.delpiero.chatgpt.site/connections",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extendedAgentCard": false
  },
  "securitySchemes": {
    "delegatedKey": {
      "httpAuthSecurityScheme": {
        "scheme": "bearer",
        "bearerFormat": "epo delegated credential"
      }
    }
  },
  "securityRequirements": [
    {
      "schemes": {
        "delegatedKey": {
          "list": []
        }
      }
    }
  ],
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "epalette-business-actions",
      "name": "検索・予約案・充電計画",
      "description": "DataPart.data に name と args を指定します。確定済み状態は共通DBから取得します。",
      "tags": [
        "mobility",
        "approval"
      ],
      "examples": [
        "get_charge_plan",
        "search_trips"
      ]
    }
  ]
}
